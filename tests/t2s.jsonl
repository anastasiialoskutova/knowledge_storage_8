{"id": "T2S-01", "question": "How many products are in the catalog?", "difficulty": "easy", "intent": "count_products", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT (COUNT(?p) AS ?count) WHERE { ?p a :Product }"}
{"id": "T2S-02", "question": "Show all products and their names.", "difficulty": "easy", "intent": "list_products", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?p ?name WHERE { ?p a :Product ; :productName ?name } LIMIT 100"}
{"id": "T2S-03", "question": "List customer IDs.", "difficulty": "easy", "intent": "list_customer_ids", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?c ?id WHERE { ?c a :Customer ; :customerId ?id } LIMIT 100"}
{"id": "T2S-04", "question": "Which products have more than 10 units in stock?", "difficulty": "medium", "intent": "high_stock", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?p ?name ?stock WHERE { ?p a :Product ; :productName ?name ; :hasInventory ?i . ?i :stockQuantity ?stock . FILTER(?stock > 10) } LIMIT 100"}
{"id": "T2S-05", "question": "Show recommendations with their scores.", "difficulty": "medium", "intent": "recommendations", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?r ?c ?p ?score WHERE { ?r a :Recommendation ; :generatedFor ?c ; :recommendsProduct ?p ; :recommendationScore ?score } LIMIT 100"}
{"id": "T2S-06", "question": "What is the average product price?", "difficulty": "medium", "intent": "average_price", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT (AVG(?amount) AS ?avg) WHERE { ?o a :Offer ; :hasPrice ?price . ?price :priceAmount ?amount }"}
{"id": "T2S-07", "question": "Are there any recommendations with score above 0.7?", "difficulty": "medium", "intent": "high_score_exists", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> ASK { ?r a :Recommendation ; :recommendationScore ?score . FILTER(?score > 0.7) }"}
{"id": "T2S-08", "question": "Show customers and email if available.", "difficulty": "medium", "intent": "customer_emails_optional", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?c ?id ?email WHERE { ?c a :Customer ; :customerId ?id . OPTIONAL { ?c :email ?email } } LIMIT 100"}
{"id": "T2S-09", "question": "List products with price and currency.", "difficulty": "medium", "intent": "product_prices", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?p ?name ?amount ?currency WHERE { ?p a :Product ; :productName ?name ; :hasOffer ?o . ?o :hasPrice ?price . ?price :priceAmount ?amount ; :currency ?currency } LIMIT 100"}
{"id": "T2S-10", "question": "Count customers.", "difficulty": "easy", "intent": "count_customers", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT (COUNT(?c) AS ?count) WHERE { ?c a :Customer }"}
{"id": "T2S-11", "question": "Show recommendations ordered by score descending.", "difficulty": "medium", "intent": "recommendations_sorted", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?r ?score WHERE { ?r a :Recommendation ; :recommendationScore ?score } ORDER BY DESC(?score) LIMIT 100"}
{"id": "T2S-12", "question": "List products belonging to categories.", "difficulty": "medium", "intent": "product_categories", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?p ?cat WHERE { ?p a :Product ; :belongsToCategory ?cat } LIMIT 100"}
{"id": "T2S-13", "question": "What is the minimum price?", "difficulty": "medium", "intent": "minimum_price", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT (MIN(?amount) AS ?min) WHERE { ?p a :Price ; :priceAmount ?amount }"}
{"id": "T2S-14", "question": "What is the maximum price?", "difficulty": "medium", "intent": "maximum_price", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT (MAX(?amount) AS ?max) WHERE { ?p a :Price ; :priceAmount ?amount }"}
{"id": "T2S-15", "question": "Find product IDs and names for products with zero stock.", "difficulty": "hard", "intent": "zero_stock", "gold_sparql": "PREFIX : <http://example.org/ecommerce-recommendations#> SELECT ?p ?id ?name WHERE { ?p a :Product ; :productId ?id ; :productName ?name ; :hasInventory ?i . ?i :stockQuantity 0 } LIMIT 100"}
