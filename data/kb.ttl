:FinancialValue a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:ProductReview a owl:Class ;
    rdfs:subClassOf :UserFeedback ;
    skos:closeMatch schema:Review .

:Refund a owl:Class ;
    rdfs:subClassOf :BusinessEvent .

:UserFeedback a owl:Class ;
    rdfs:subClassOf :BusinessEvent .

:Wishlist a owl:Class ;
    rdfs:subClassOf :CustomerActivity .

