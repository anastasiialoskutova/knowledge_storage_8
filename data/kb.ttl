:Order a owl:Class ;
    rdfs:subClassOf :BusinessEvent ;
    skos:closeMatch schema:Order .

:Payment a owl:Class ;
    rdfs:subClassOf :BusinessEvent .

:ProductRating a owl:Class ;
    rdfs:subClassOf :UserFeedback ;
    skos:closeMatch schema:Rating .

:Session a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:brand01 a :Brand ;
    rdfs:label "TechNova"@en .

:recommendsProduct a owl:ObjectProperty ;
    rdfs:domain :Recommendation ;
    rdfs:range :Product .

:RecommendationModel a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:Brand a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity ;
    skos:closeMatch schema:Brand .

:DemoCategory1 a :ProductCategory ;
    rdfs:label "Demo category 1" .

:DemoCategory2 a :ProductCategory ;
    rdfs:label "Demo category 2" .

:DemoCategory3 a :ProductCategory ;
    rdfs:label "Demo category 3" .

:DemoCategory4 a :ProductCategory ;
    rdfs:label "Demo category 4" .

:category01 a :ProductCategory ;
    rdfs:label "Electronics"@en .

:model01 a :RecommendationModel ;
    rdfs:label "Personalized recommendation model"@en ;
    :modelVersion "1.0" .

:BehaviorFeature a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:RelevanceScore a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:SegmentNew a :CustomerSegment ;
    rdfs:label "New customer" .

:SegmentReturning a :CustomerSegment ;
    rdfs:label "Returning customer" .

:PurchaseHistory a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:UserInteraction a owl:Class ;
    rdfs:subClassOf :BusinessEvent .

:BusinessEvent a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:CustomerSegment a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:Purchase a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :containsItem ;
            owl:someValuesFrom :PurchaseItem ],
        :BusinessEvent .

:PurchaseItem a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:ProductCategory a owl:Class ;
    rdfs:subClassOf :CatalogEntity ;
    skos:closeMatch schema:CategoryCode .

:Recommendation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :recommendsProduct ;
            owl:someValuesFrom :Product ],
        [ a owl:Restriction ;
            owl:allValuesFrom :Product ;
            owl:onProperty :recommendsProduct ],
        [ a owl:Restriction ;
            owl:onClass :Product ;
            owl:onProperty :recommendsProduct ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :KnowledgeEntity .

:KnowledgeEntity a owl:Class ;
    rdfs:subClassOf :TopLevelEntity .

:CustomerProfile a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:Inventory a owl:Class ;
    rdfs:subClassOf :KnowledgeEntity .

:Customer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasProfile ;
            owl:someValuesFrom :CustomerProfile ],
        [ a owl:Restriction ;
            owl:onClass :CustomerProfile ;
            owl:onProperty :hasProfile ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Agent .

:Offer a owl:Class ;
    rdfs:subClassOf :CommercialEntity ;
    skos:closeMatch schema:Offer .

:Price a owl:Class ;
    rdfs:subClassOf :FinancialValue .

:Product a owl:Class ;
    rdfs:seeAlso schema:Product ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :ProductCategory ;
            owl:onProperty :belongsToCategory ],
        :CatalogEntity ;
    skos:closeMatch schema:Product .

[] a owl:AllDisjointClasses ;
    owl:members ( :CustomerProfile :PurchaseHistory :ShoppingCart :Wishlist :Session ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Purchase :Order :Payment :UserInteraction :ProductReview :ProductRating ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Customer :Product :ProductCategory :Brand :Recommendation :RecommendationModel ) .

